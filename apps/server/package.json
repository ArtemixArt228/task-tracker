{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "test": "bun test"
  },
  "dependencies": {
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@task-tracker/api": "workspace:*",
    "@task-tracker/db": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.7",
    "pino": "^10.4.0",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@task-tracker/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
